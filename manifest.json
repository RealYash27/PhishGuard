{
  "manifest_version": 3,
  "name": "PhishSpectre",
  "version": "0.7.0",
  "description": "Phishing & URL risk detector with heuristics, typosquatting checks, domain age, and reputation lookups (VirusTotal, PhishStats, urlscan.io, Google Safe Browsing).",
  "action": {
    "default_title": "PhishSpectre",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.phishstats.info/*",
    "https://cloudflare-dns.com/*",
    "https://dns.google/*",
    "https://ipapi.co/*",
    "https://ipwho.is/*",
    "https://urlscan.io/*",
    "https://www.virustotal.com/*",
    "https://safebrowsing.googleapis.com/*",
    "https://rdap.org/*",
    "https://rdap.verisign.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/cyber.png",
    "48": "assets/cyber.png",
    "128": "assets/cyber.png"
  }
}
